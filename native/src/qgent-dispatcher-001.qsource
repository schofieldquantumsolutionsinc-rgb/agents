# QGENT DISPATCHER 001 — rehearsal implementation of QGENT DISPATCH ABI 001
# Native QSOURCE-1 -> QBN1 via JLSQ V17 GRACE PILER; runs on QRUNTIME/QSEED-1.
#
# Stream protocol (data section = 16-byte records: tag i64, value i64):
#   STATE  records (first, in order): (0,cur_rev) (9,claim_comp)
#          (10,claim_holder) (11,last_nonce) (12,ev_counter)
#   REQUEST records (in order): (1,action) (2,identity) (3,authority)
#          (4,rev_seen) (5,req_claim_comp) (6,claim_mode) (7,session) (8,nonce)
# One request per run. Result line (stdout):
#   RES <OK|RJ|NY|US|UK> A=<a3> ID=<i3> CAP=<d> RR=<r3> RW=<r3> EV=<e3>
#       ERR=<e3> CC=<c3> CH=<c3> LN=<n6>
# Status: OK executed; RJ rejected (ERR: 10 identity, 11 authority,
#   12 stale revision, 13 claim conflict, 14 claim not held, 15 replay,
#   16 claim mode); NY declared NOT YET IMPLEMENTED; US UNSUPPORTED;
#   UK capability UNKNOWN (all per QGENT_ACTION_MATRIX_001).
# Execution order per ABI: QREADER -> QAUTHORITY -> QCLAIM -> QOUTER
#   -> QRUNTIME -> QEVIDENCE -> QREVISION_WRITE.
    NEXT
    SWAP
    PUSH 0
    EQ
    ASSERT
    NEXT
    SWAP
    PUSH 9
    EQ
    ASSERT
    NEXT
    SWAP
    PUSH 10
    EQ
    ASSERT
    NEXT
    SWAP
    PUSH 11
    EQ
    ASSERT
    NEXT
    SWAP
    PUSH 12
    EQ
    ASSERT
    NEXT
    SWAP
    PUSH 1
    EQ
    ASSERT
    NEXT
    SWAP
    PUSH 2
    EQ
    ASSERT
    NEXT
    SWAP
    PUSH 3
    EQ
    ASSERT
    NEXT
    SWAP
    PUSH 4
    EQ
    ASSERT
    NEXT
    SWAP
    PUSH 5
    EQ
    ASSERT
    NEXT
    SWAP
    PUSH 6
    EQ
    ASSERT
    NEXT
    SWAP
    PUSH 7
    EQ
    ASSERT
    NEXT
    SWAP
    PUSH 8
    EQ
    ASSERT
# ---------- GATE 1 (QREADER/continuity): rev_seen == cur_rev ----------
    PICK 4
    PICK 13
    EQ
    JZ RJ_STALE
# ---------- GATE 2a (QAUTHORITY): identity in {101..106} ----------
    PICK 6
    DUP
    PUSH 101
    EQ
    PICK 1
    PUSH 102
    EQ
    ADD
    PICK 1
    PUSH 103
    EQ
    ADD
    PICK 1
    PUSH 104
    EQ
    ADD
    PICK 1
    PUSH 105
    EQ
    ADD
    PICK 1
    PUSH 106
    EQ
    ADD
    PUSH 1
    EQ
    JZ RJ_ID_PRE
    DROP
# ---------- GATE 2b (QAUTHORITY): authority > 0 ----------
    PICK 5
    PUSH 0
    GT
    JZ RJ_AUTH
# ---------- GATE 3 (replay): nonce > last_nonce ----------
    PICK 0
    PICK 10
    GT
    JZ RJ_REPLAY
# ---------- GATE 4 (QCLAIM) ----------
    PICK 7
    PUSH 8
    EQ
    JZ G4_NONCLAIM
    PICK 2
    PUSH 1
    EQ
    JZ G4_TRYREL
    JMP G4_ACQ
G4_TRYREL:
    PICK 2
    PUSH 2
    EQ
    JZ RJ_MODE
    PICK 11
    PUSH 0
    EQ
    JZ G4_REL_B
    JMP RJ_NOTHELD
G4_REL_B:
    PICK 11
    PICK 4
    EQ
    JZ RJ_NOTHELD
    PICK 10
    PICK 7
    EQ
    JZ RJ_NOTHELD
    JMP H_CLAIM_REL
G4_ACQ:
    PICK 11
    PUSH 0
    EQ
    JZ G4_ACQ_B
    JMP H_CLAIM_ACQ
G4_ACQ_B:
    PICK 11
    PICK 4
    EQ
    JZ RJ_CONFLICT
    PICK 10
    PICK 7
    EQ
    JZ RJ_CONFLICT
    JMP H_CLAIM_ACQ
G4_NONCLAIM:
    PICK 3
    PUSH 0
    EQ
    JZ G4_NC_B
    JMP ROUTE
G4_NC_B:
    PICK 11
    PUSH 0
    EQ
    JZ G4_NC_C
    JMP ROUTE
G4_NC_C:
    PICK 11
    PICK 4
    EQ
    JZ RJ_CONFLICT
    PICK 10
    PICK 7
    EQ
    JZ RJ_CONFLICT
    JMP ROUTE
# ---------- ROUTING (QOUTER) ----------
ROUTE:
    PICK 7
    PUSH 7
    EQ
    JZ RT_14
    JMP H_READ
RT_14:
    PICK 7
    PUSH 14
    EQ
    JZ RT_15
    JMP H_UNK
RT_15:
    PICK 7
    PUSH 15
    EQ
    JZ RT_NYI
    JMP H_UNSUP
RT_NYI:
    PICK 7
    DUP
    PUSH 1
    EQ
    PICK 1
    PUSH 2
    EQ
    ADD
    PICK 1
    PUSH 3
    EQ
    ADD
    PICK 1
    PUSH 4
    EQ
    ADD
    PICK 1
    PUSH 5
    EQ
    ADD
    PICK 1
    PUSH 6
    EQ
    ADD
    PICK 1
    PUSH 9
    EQ
    ADD
    PICK 1
    PUSH 10
    EQ
    ADD
    PICK 1
    PUSH 11
    EQ
    ADD
    PICK 1
    PUSH 12
    EQ
    ADD
    PICK 1
    PUSH 13
    EQ
    ADD
    PUSH 1
    EQ
    JZ RT_UNSUP2
    DROP
    JMP H_NYI
RT_UNSUP2:
    DROP
    JMP H_UNSUP
# ---------- HANDLERS (build result block: status cap err rw cc ch ln ev)
H_READ:
    PUSH 0
    PUSH 0
    PUSH 0
    PICK 15
    PICK 15
    PICK 15
    PICK 6
    PICK 15
    PUSH 1
    ADD
    JMP EMIT
H_CLAIM_ACQ:
    PUSH 0
    PUSH 0
    PUSH 0
    PICK 15
    PUSH 1
    ADD
    PICK 7
    PICK 11
    PICK 6
    PICK 15
    PUSH 1
    ADD
    JMP EMIT
H_CLAIM_REL:
    PUSH 0
    PUSH 0
    PUSH 0
    PICK 15
    PUSH 1
    ADD
    PUSH 0
    PUSH 0
    PICK 6
    PICK 15
    PUSH 1
    ADD
    JMP EMIT
H_NYI:
    PUSH 2
    PUSH 1
    PUSH 0
    PICK 15
    PICK 15
    PICK 15
    PICK 6
    PUSH 0
    JMP EMIT
H_UNSUP:
    PUSH 1
    PUSH 2
    PUSH 0
    PICK 15
    PICK 15
    PICK 15
    PICK 6
    PUSH 0
    JMP EMIT
H_UNK:
    PUSH 3
    PUSH 3
    PUSH 0
    PICK 15
    PICK 15
    PICK 15
    PICK 6
    PUSH 0
    JMP EMIT
# ---------- REJECTS ----------
RJ_STALE:
    PUSH 9
    PUSH 4
    PUSH 12
    PICK 15
    PICK 15
    PICK 15
    PICK 15
    PUSH 0
    JMP EMIT
RJ_ID_PRE:
    DROP
    PUSH 9
    PUSH 4
    PUSH 10
    PICK 15
    PICK 15
    PICK 15
    PICK 15
    PUSH 0
    JMP EMIT
RJ_AUTH:
    PUSH 9
    PUSH 4
    PUSH 11
    PICK 15
    PICK 15
    PICK 15
    PICK 15
    PUSH 0
    JMP EMIT
RJ_REPLAY:
    PUSH 9
    PUSH 4
    PUSH 15
    PICK 15
    PICK 15
    PICK 15
    PICK 15
    PUSH 0
    JMP EMIT
RJ_MODE:
    PUSH 9
    PUSH 4
    PUSH 16
    PICK 15
    PICK 15
    PICK 15
    PICK 15
    PUSH 0
    JMP EMIT
RJ_NOTHELD:
    PUSH 9
    PUSH 4
    PUSH 14
    PICK 15
    PICK 15
    PICK 15
    PICK 15
    PUSH 0
    JMP EMIT
RJ_CONFLICT:
    PUSH 9
    PUSH 4
    PUSH 13
    PICK 15
    PICK 15
    PICK 15
    PICK 15
    PUSH 0
    JMP EMIT
EMIT:
    PUSH 82
    EMIT
    PUSH 69
    EMIT
    PUSH 83
    EMIT
    PUSH 32
    EMIT
    PICK 7
    PUSH 0
    EQ
    JZ TOK_1
    PUSH 79
    EMIT
    PUSH 75
    EMIT
    JMP TOK_DONE
TOK_1:
    PICK 7
    PUSH 1
    EQ
    JZ TOK_2
    PUSH 85
    EMIT
    PUSH 83
    EMIT
    JMP TOK_DONE
TOK_2:
